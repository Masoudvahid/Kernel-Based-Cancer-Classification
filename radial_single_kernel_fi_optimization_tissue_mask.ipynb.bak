   "source": [
    "# Structured composite-kernel heatmap right after pipeline training.\n",
    "structured_kernel_stack_path = EXP_DIR / \"composite_kernels.npy\"\n",
    "structured_single_kernel_path = EXP_DIR / KERNEL_FILENAME\n",
    "\n",
    "if structured_kernel_stack_path.exists():\n",
    "    structured_kernels = np.load(structured_kernel_stack_path).astype(np.float32)\n",
    "    if structured_kernels.ndim == 2:\n",
    "        structured_kernels = structured_kernels[None, ...]\n",
    "elif structured_single_kernel_path.exists():\n",
    "    structured_kernels = np.load(structured_single_kernel_path).astype(np.float32)[None, ...]\n",
    "else:\n",
    "    raise FileNotFoundError(\n",
    "        f\"Missing kernel artifacts. Expected either {structured_kernel_stack_path} or {structured_single_kernel_path}\"\n",
    "    )\n",
    "\n",
    "if structured_kernels.ndim != 3:\n",
    "    raise ValueError(f\"Expected kernel stack with shape [n_kernels, h, w], got {structured_kernels.shape}\")\n",
    "\n",
    "structured_example_path = Path('data_brain/brisc2025/segmentation_task/train/images/brisc2025_train_00010_gl_ax_t1.jpg')\n",
    "# structured_example_path = ensure_example_image(EXAMPLE_IMAGE_PATH)\n",
    "structured_img_arr = np.array(Image.open(structured_example_path).convert(\"L\"), dtype=np.float32) / 255.0\n",
    "\n",
    "structured_mask_path = None\n",
    "mask_candidates = []\n",
    "if structured_example_path.parent.name == \"images\":\n",
    "    mask_candidates.append(structured_example_path.parent.parent / \"masks\" / f\"{structured_example_path.stem}.png\")\n",
    "mask_candidates.extend(\n",
    "    [\n",
    "        MASK_DATASET_DIR / \"train\" / \"masks\" / f\"{structured_example_path.stem}.png\",\n",
    "        MASK_DATASET_DIR / \"test\" / \"masks\" / f\"{structured_example_path.stem}.png\",\n",
    "    ]\n",
    ")\n",
    "for cand in mask_candidates:\n",
    "    if cand.exists():\n",
    "        structured_mask_path = cand\n",
    "        break\n",
    "\n",
    "structured_mask_bool = None\n",
    "if structured_mask_path is not None:\n",
    "    structured_mask_arr = np.array(Image.open(structured_mask_path).convert(\"L\"), dtype=np.uint8)\n",
    "    if structured_mask_arr.shape != structured_img_arr.shape:\n",
    "        structured_mask_arr = cv2.resize(\n",
    "            structured_mask_arr,\n",
    "            (structured_img_arr.shape[1], structured_img_arr.shape[0]),\n",
    "            interpolation=cv2.INTER_NEAREST,\n",
    "        )\n",
    "    structured_mask_bool = structured_mask_arr >= int(MASK_WHITE_THRESHOLD)\n",
    "    if not structured_mask_bool.any():\n",
    "        structured_mask_bool = structured_mask_arr > 0\n",
    "\n",
    "structured_x_t = to_tensor_batch(structured_img_arr[None, ...].astype(np.float32), torch.device(\"cpu\"))\n",
    "if STANDARDIZE_PATCHES:\n",
    "    structured_x_t = patch_standardize(structured_x_t)\n",
    "\n",
    "with torch.no_grad():\n",
    "    xb = structured_x_t.to(DEVICE, non_blocking=True)\n",
    "    kernels_t = torch.from_numpy(structured_kernels).to(DEVICE)\n",
    "    out = F.conv2d(xb, kernels_t[:, None], padding=structured_kernels.shape[-1] // 2)[0]\n",
    "    structured_feature_map = out.abs().amax(dim=0).detach().cpu().numpy().astype(np.float32)\n",
    "\n",
    "f_min = float(structured_feature_map.min())\n",
    "f_max = float(structured_feature_map.max())\n",
    "if f_max > f_min:\n",
    "    structured_heatmap = (structured_feature_map - f_min) / (f_max - f_min)\n",
    "else:\n",
    "    structured_heatmap = np.zeros_like(structured_feature_map, dtype=np.float32)\n",
    "\n",
    "structured_heatmap_vis = (\n",
    "    gaussian_filter(structured_heatmap, sigma=float(HEATMAP_SMOOTH_SIGMA))\n",
    "    if HEATMAP_SMOOTH_SIGMA > 0\n",
    "    else structured_heatmap\n",
    ")\n",
    "\n",
    "structured_score_max = float(structured_heatmap.max())\n",
    "structured_score_mean = float(structured_heatmap.mean())\n",
    "\n",
    "fig, axes = plt.subplots(1, 4, figsize=(19, 4.5))\n",
    "axes[0].imshow(structured_img_arr, cmap=\"gray\")\n",
    "axes[0].set_title(f\"Original\\n{structured_example_path.name}\")\n",
    "axes[0].axis(\"off\")\n",
    "\n",
    "axes[1].imshow(structured_img_arr, cmap=\"gray\")\n",
    "im = axes[1].imshow(\n",
    "    structured_heatmap_vis,\n",
    "    cmap=\"jet\",\n",
    "    alpha=DENSE_OVERLAY_ALPHA,\n",
    "    vmin=0.0,\n",
    "    vmax=1.0,\n",
    "    interpolation=\"bilinear\",\n",
    ")\n",
    "axes[1].set_title(\n",
    "    \"Structured overlay heatmap\\n\"\n",
    "    f\"max={structured_score_max:.3f} mean={structured_score_mean:.3f}\"\n",
    ")\n",
    "axes[1].axis(\"off\")\n",
    "\n",
    "axes[2].imshow(structured_heatmap_vis, cmap=\"jet\", vmin=0.0, vmax=1.0, interpolation=\"bilinear\")\n",
    "axes[2].set_title(\"Structured heatmap only\")\n",
    "axes[2].axis(\"off\")\n",
    "\n",
    "axes[3].imshow(structured_img_arr, cmap=\"gray\")\n",
    "if structured_mask_bool is not None:\n",
    "    red_overlay = np.zeros((*structured_img_arr.shape, 4), dtype=np.float32)\n",
    "    red_overlay[..., 0] = 1.0\n",
    "    red_overlay[..., 3] = structured_mask_bool.astype(np.float32) * 0.45\n",
    "    axes[3].imshow(red_overlay, interpolation=\"nearest\")\n",
    "    axes[3].set_title(\"Tumor mask overlay (red)\")\n",
    "else:\n",
    "    axes[3].set_title(\"Tumor mask overlay (red)\\nmask not found\")\n",
    "axes[3].axis(\"off\")\n",
    "\n",
    "fig.suptitle(\n",
    "    \"Structured kernel inference (max activation across kernels)\",\n",
    "    y=1.03,\n",
    ")\n",
    "cbar = fig.colorbar(im, ax=axes.ravel().tolist(), shrink=0.8)\n",
    "cbar.set_label(\"Relative cancer activation (0-1)\")\n",
    "fig.subplots_adjust(top=0.82, wspace=0.05)\n",
    "plt.show()\n",
    "\n",
    "if SAVE_ARTIFACTS:\n",
    "    structured_heatmap_fig_path = EXP_DIR / f\"{structured_example_path.stem}_structured_kernel_heatmap.png\"\n",
    "    structured_heatmap_npy_path = EXP_DIR / f\"{structured_example_path.stem}_structured_kernel_heatmap.npy\"\n",
    "    fig.savefig(structured_heatmap_fig_path, dpi=260, bbox_inches=\"tight\")\n",
    "    np.save(structured_heatmap_npy_path, structured_heatmap)\n",
    "    print(f\"Saved structured heatmap figure: {structured_heatmap_fig_path}\")\n",
    "    print(f\"Saved structured heatmap map: {structured_heatmap_npy_path}\")\n"
   ]
