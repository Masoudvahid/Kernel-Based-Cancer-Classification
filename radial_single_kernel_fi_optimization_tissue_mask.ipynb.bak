   ],
   "source": [
    "# Hyperparameters for progressive block training\n",
    "SPIKE_FREE_EPOCHS = 20  # 4 groups * 5 epochs\n",
    "SPIKE_FREE_LR_PROFILE = 3e-2\n",
    "SPIKE_FREE_LR_HEAD = 1e-2\n",
    "SPIKE_FREE_LAMBDA_SMOOTH = 1e-2\n",
    "SPIKE_FREE_LAMBDA_CURVATURE = 2e-2\n",
    "SPIKE_FREE_LAMBDA_ANCHOR = 1e-1\n",
    "SPIKE_FREE_LAMBDA_SCALE = 5e-2\n",
    "SPIKE_FREE_OUT_DIR = OUT_DIR / \"spike_free_signed\"\n",
    "SPIKE_FREE_OUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Prepare DataLoader\n",
    "spike_free_train_loader = DataLoader(\n",
    "    TensorDataset(X_train_t, y_train_t),\n",
    "    batch_size=BATCH_SIZE,\n",
    "    shuffle=True,\n",
    ")\n",
    "\n",
    "# Number of learnable bins - train all bins as recommended\n",
    "learnable_len = full_radius_count\n",
    "\n",
    "# Split seed profile\n",
    "f_seed_learn = f_seed_full[:learnable_len].copy()\n",
    "f_tail_fixed = f_seed_full[learnable_len:].copy()\n",
    "\n",
    "f_seed_learn_t = torch.from_numpy(f_seed_learn).to(DEVICE)\n",
    "f_tail_fixed_t = torch.from_numpy(f_tail_fixed).to(DEVICE)\n",
    "seed_norm = float(np.linalg.norm(f_seed_full))\n",
    "\n",
    "# Parameters\n",
    "f_learn_sf = torch.nn.Parameter(f_seed_learn_t.clone())\n",
    "head_w_sf = torch.nn.Parameter(torch.tensor(1.0, dtype=torch.float32, device=DEVICE))\n",
    "head_b_sf = torch.nn.Parameter(torch.tensor(0.0, dtype=torch.float32, device=DEVICE))\n",
    "\n",
    "sf_optimizer = torch.optim.Adam([\n",
    "    {\"params\": [f_learn_sf], \"lr\": SPIKE_FREE_LR_PROFILE},\n",
    "    {\"params\": [head_w_sf, head_b_sf], \"lr\": SPIKE_FREE_LR_HEAD},\n",
    "])\n",
    "sf_loss_fn = torch.nn.BCEWithLogitsLoss()\n",
    "\n",
    "def build_sf_kernel(f_learn_t: torch.Tensor):\n",
    "    if f_tail_fixed_t.numel() > 0:\n",
    "        f_full_t = torch.cat([f_learn_t, f_tail_fixed_t], dim=0)\n",
    "    else:\n",
    "        f_full_t = f_learn_t\n",
    "    kernel_t = torch.einsum(\"r,rhw->hw\", f_full_t, basis_t)\n",
    "    return kernel_t, f_full_t\n",
    "\n",
    "sf_best_state = None\n",
    "sf_best_val_auc = -float(\"inf\")\n",
    "sf_history = []\n",
    "\n",
    "for epoch in range(1, SPIKE_FREE_EPOCHS + 1):\n",
    "    total_loss = 0.0\n",
    "    n_seen = 0\n",
    "    \n",
    "    # # Determine progressive active window for this epoch\n",
    "    # group_idx = (epoch - 1) // 5\n",
    "    # active_start = 4 * group_idx\n",
    "    # active_end = min(active_start + 3, learnable_len - 1)\n",
    "    \n",
    "    # if active_start <= learnable_len - 1:\n",
    "    #     print(f\"\\n--- Epoch {epoch:02d}: Training bins {active_start} to {active_end} (others locked) ---\")\n",
    "    # else:\n",
    "    #     print(f\"\\n--- Epoch {epoch:02d}: All bins locked (only training classification head) ---\")\n",
    "    print(f\"\\n--- Epoch {epoch:02d}\")\n",
    "\n",
    "    for xb, yb in spike_free_train_loader:\n",
    "        xb = xb.to(DEVICE, non_blocking=True)\n",
    "        yb = yb.to(DEVICE, non_blocking=True)\n",
    "        \n",
    "        # Build kernel and profile\n",
    "        sf_kernel_t, f_full_t = build_sf_kernel(f_learn_sf)\n",
    "        sf_feat = response_from_kernel(xb, sf_kernel_t, RESPONSE_MODE)\n",
    "        sf_logits = head_w_sf * sf_feat + head_b_sf\n",
    "        \n",
    "        # Loss computation\n",
    "        loss_cls = sf_loss_fn(sf_logits, yb)\n",
    "        \n",
    "        # Regularizations computed on the FULL concatenated profile\n",
    "        loss_smooth = torch.mean((f_full_t[1:] - f_full_t[:-1]) ** 2)\n",
    "        loss_curvature = torch.mean((f_full_t[2:] - 2.0 * f_full_t[1:-1] + f_full_t[:-2]) ** 2)\n",
    "        loss_anchor = torch.mean((f_learn_sf - f_seed_learn_t) ** 2)\n",
    "        loss_scale = (torch.norm(f_full_t) - seed_norm) ** 2\n",
    "        \n",
    "        loss = (\n",
    "            loss_cls\n",
    "            + SPIKE_FREE_LAMBDA_SMOOTH * loss_smooth\n",
    "            + SPIKE_FREE_LAMBDA_CURVATURE * loss_curvature\n",
    "            + SPIKE_FREE_LAMBDA_ANCHOR * loss_anchor\n",
    "            + SPIKE_FREE_LAMBDA_SCALE * loss_scale\n",
    "        )\n",
    "        \n",
    "        sf_optimizer.zero_grad()\n",
    "        loss.backward()\n",
    "        \n",
    "        # # Apply progressive block gradient locking mask\n",
    "        # if f_learn_sf.grad is not None:\n",
    "        #     grad_mask = torch.zeros_like(f_learn_sf)\n",
    "        #     if active_start <= learnable_len - 1:\n",
    "        #         grad_mask[active_start : active_end + 1] = 1.0\n",
    "        #     f_learn_sf.grad.mul_(grad_mask)\n",
    "            \n",
    "        sf_optimizer.step()\n",
    "        \n",
    "        batch_n = xb.shape[0]\n",
    "        total_loss += float(loss.item()) * batch_n\n",
    "        n_seen += batch_n\n",
    "        \n",
    "    # Evaluation on Validation Split\n",
    "    with torch.no_grad():\n",
    "        sf_kernel_eval_t, _ = build_sf_kernel(f_learn_sf)\n",
    "        sf_val_resp = extract_responses(X_val_t, sf_kernel_eval_t, BATCH_SIZE)\n",
    "        sf_val_probs = sigmoid_np(float(head_w_sf.detach().cpu()) * sf_val_resp + float(head_b_sf.detach().cpu()))\n",
    "        sf_val_metrics = metrics_from_probs(y_val, sf_val_probs, threshold=0.5)\n",
    "        \n",
    "        sf_train_resp = extract_responses(X_train_t, sf_kernel_eval_t, BATCH_SIZE)\n",
    "        sf_train_probs = sigmoid_np(float(head_w_sf.detach().cpu()) * sf_train_resp + float(head_b_sf.detach().cpu()))\n",
    "        sf_train_metrics = metrics_from_probs(y_train, sf_train_probs, threshold=0.5)\n",
    "        \n",
    "    sf_history.append({\n",
    "        \"epoch\": int(epoch),\n",
    "        \"loss\": float(total_loss / max(n_seen, 1)),\n",
    "        \"val_auc\": float(sf_val_metrics[\"auc\"]),\n",
    "        \"val_acc\": float(sf_val_metrics[\"acc\"]),\n",
    "        \"head_w\": float(head_w_sf.detach().cpu()),\n",
    "        \"head_b\": float(head_b_sf.detach().cpu()),\n",
    "    })\n",
    "    \n",
    "    if sf_val_metrics[\"auc\"] > sf_best_val_auc:\n",
    "        sf_best_val_auc = sf_val_metrics[\"auc\"]\n",
    "        sf_best_state = {\n",
    "            \"epoch\": int(epoch),\n",
    "            \"f_learn\": f_learn_sf.detach().cpu().clone(),\n",
    "            \"head_w\": float(head_w_sf.detach().cpu()),\n",
    "            \"head_b\": float(head_b_sf.detach().cpu()),\n",
    "            \"val_auc\": float(sf_val_metrics[\"auc\"]),\n",
    "            \"val_acc\": float(sf_val_metrics[\"acc\"]),\n",
    "        }\n",
    "        \n",
    "    print(\n",
    "        f\"spike-free epoch={epoch:02d} | \"\n",
    "        f\"loss={sf_history[-1]['loss']:.6f} | \"\n",
    "        f\"train_auc={sf_train_metrics['auc']:.6f} train_acc={sf_train_metrics['acc']:.6f} | \"\n",
    "        f\"val_auc={sf_val_metrics['auc']:.6f} val_acc={sf_val_metrics['acc']:.6f} | \"\n",
    "        f\"w={float(head_w_sf.detach().cpu()):+.4f} b={float(head_b_sf.detach().cpu()):+.4f}\"\n",
    "    )\n",
    "\n",
    "print(\"\\nRestoring best spike-free checkpoint:\")\n",
    "print(sf_best_state)\n",
    "\n",
    "sf_f_learn_best = sf_best_state[\"f_learn\"].to(DEVICE)\n",
    "sf_head_w_best = float(sf_best_state[\"head_w\"])\n",
    "sf_head_b_best = float(sf_best_state[\"head_b\"])\n",
    "\n",
    "with torch.no_grad():\n",
    "    kernel_best_sf_t, f_best_full_sf_t = build_sf_kernel(sf_f_learn_best)\n",
    "\n",
    "f_best_full_sf = f_best_full_sf_t.detach().cpu().numpy().astype(np.float32)\n",
    "kernel_best_sf = kernel_best_sf_t.detach().cpu().numpy().astype(np.float32)\n",
    "\n",
    "# Logistic regression calibration\n",
    "train_resp_sf = extract_responses(X_train_t, kernel_best_sf_t.detach(), BATCH_SIZE)\n",
    "val_resp_sf = extract_responses(X_val_t, kernel_best_sf_t.detach(), BATCH_SIZE)\n",
    "test_resp_sf = extract_responses(X_test_t, kernel_best_sf_t.detach(), BATCH_SIZE)\n",
    "\n",
    "calib_mu_sf = float(train_resp_sf.mean())\n",
    "calib_std_sf = float(train_resp_sf.std())\n",
    "calib_std_sf = calib_std_sf if calib_std_sf > 1e-8 else 1.0\n",
    "\n",
    "calib_clf_sf = LogisticRegression(max_iter=1000)\n",
    "calib_clf_sf.fit(((train_resp_sf - calib_mu_sf) / calib_std_sf).reshape(-1, 1), y_train)\n",
    "\n",
    "calib_w_sf = float(calib_clf_sf.coef_[0, 0])\n",
    "calib_b_sf = float(calib_clf_sf.intercept_[0])\n",
    "\n",
    "train_probs_sf = calib_clf_sf.predict_proba(((train_resp_sf - calib_mu_sf) / calib_std_sf).reshape(-1, 1))[:, 1]\n",
    "val_probs_sf = calib_clf_sf.predict_proba(((val_resp_sf - calib_mu_sf) / calib_std_sf).reshape(-1, 1))[:, 1]\n",
    "test_probs_sf = calib_clf_sf.predict_proba(((test_resp_sf - calib_mu_sf) / calib_std_sf).reshape(-1, 1))[:, 1]\n",
    "\n",
    "sf_threshold_val, sf_val_acc_tuned = best_threshold_by_accuracy(y_val, val_probs_sf, THRESHOLD_GRID_SIZE)\n",
    "\n",
    "sf_results = {\n",
    "    \"val_05\": metrics_from_probs(y_val, val_probs_sf, threshold=0.5),\n",
    "    \"val_tuned\": metrics_from_probs(y_val, val_probs_sf, threshold=sf_threshold_val),\n",
    "    \"test_05\": metrics_from_probs(y_test, test_probs_sf, threshold=0.5),\n",
    "    \"test_tuned\": metrics_from_probs(y_test, test_probs_sf, threshold=sf_threshold_val),\n",
    "    \"threshold_val\": float(sf_threshold_val),\n",
    "    \"best_epoch\": int(sf_best_state[\"epoch\"]),\n",
    "    \"optimizer_head_w\": sf_head_w_best,\n",
    "    \"optimizer_head_b\": sf_head_b_best,\n",
    "    \"calib_mu\": calib_mu_sf,\n",
    "    \"calib_std\": calib_std_sf,\n",
    "    \"calib_w\": calib_w_sf,\n",
    "    \"calib_b\": calib_b_sf,\n",
    "}\n",
    "\n",
    "print(\"\\nCalibrated progressive block radial-kernel metrics:\")\n",
    "print(\n",
    "    f\"  Val  | AUC={sf_results['val_05']['auc']:.6f} ACC@0.5={sf_results['val_05']['acc']:.6f} \"\n",
    "    f\"ACC@thr_val={sf_results['val_tuned']['acc']:.6f} (thr_val={sf_results['threshold_val']:.3f})\"\n",
    ")\n",
    "print(\n",
    "    f\"  Test | AUC={sf_results['test_05']['auc']:.6f} ACC@0.5={sf_results['test_05']['acc']:.6f} \"\n",
    "    f\"ACC@thr_val={sf_results['test_tuned']['acc']:.6f}\"\n",
    ")\n",
    "\n",
    "# Plotting the results\n",
    "fig, axes = plt.subplots(1, 4, figsize=(18, 4))\n",
    "sf_vmax = max(float(np.max(np.abs(seed_radial_kernel))), float(np.max(np.abs(kernel_best_sf)))) + 1e-12\n",
    "\n",
    "axes[0].imshow(seed_radial_kernel, cmap=\"coolwarm\", vmin=-sf_vmax, vmax=sf_vmax)\n",
    "axes[0].set_title(\"Seed radial kernel\")\n",
    "axes[0].axis(\"off\")\n",
    "\n",
    "axes[1].imshow(kernel_best_sf, cmap=\"coolwarm\", vmin=-sf_vmax, vmax=sf_vmax)\n",
    "axes[1].set_title(\"Progressive radial kernel\")\n",
    "axes[1].axis(\"off\")\n",
    "\n",
    "axes[2].plot(np.arange(len(f_seed_full)), f_seed_full, marker=\"o\", linewidth=1.2, alpha=0.5, label=\"seed\")\n",
    "if \"f_best_full\" in globals():\n",
    "    axes[2].plot(np.arange(len(f_best_full)), f_best_full, marker=\"s\", linewidth=1.2, alpha=0.5, label=\"spiked learned\")\n",
    "axes[2].plot(np.arange(len(f_best_full_sf)), f_best_full_sf, marker=\"D\", linewidth=2.0, label=\"progressive learned\")\n",
    "axes[2].axvline(learnable_len - 1, color=\"tab:red\", linestyle=\"--\", linewidth=1, label=\"boundary\")\n",
    "axes[2].set_xlabel(\"radius bin\")\n",
    "axes[2].set_ylabel(\"f(r)\")\n",
    "axes[2].set_title(\"Seed vs progressive profile\")\n",
    "axes[2].grid(alpha=0.3)\n",
    "axes[2].legend()\n",
    "\n",
    "sf_epochs = np.array([row[\"epoch\"] for row in sf_history], dtype=int)\n",
    "sf_val_auc_curve = np.array([row[\"val_auc\"] for row in sf_history], dtype=np.float32)\n",
    "sf_val_acc_curve = np.array([row[\"val_acc\"] for row in sf_history], dtype=np.float32)\n",
    "axes[3].plot(sf_epochs, sf_val_auc_curve, label=\"val AUC\")\n",
    "axes[3].plot(sf_epochs, sf_val_acc_curve, label=\"val ACC@0.5\")\n",
    "axes[3].set_xlabel(\"epoch\")\n",
    "axes[3].set_title(\"Validation curves\")\n",
    "axes[3].grid(alpha=0.3)\n",
    "axes[3].legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Heatmap prediction visualization\n",
    "sf_heatmap_window = RESIZE_PATCH if (RESIZE_PATCH % 2 == 1) else (RESIZE_PATCH - 1)\n",
    "sf_raw_map, sf_feature_map = dense_signed_peak_feature_map(\n",
    "    to_tensor_batch(structured_img_arr[None, ...].astype(np.float32), torch.device(\"cpu\")),\n",
    "    torch.from_numpy(kernel_best_sf),\n",
    "    pool_window=sf_heatmap_window,\n",
    ")\n",
    "\n",
    "prob_map_sf = sigmoid_np(\n",
    "    calib_w_sf * ((sf_feature_map - calib_mu_sf) / calib_std_sf) + calib_b_sf\n",
    ").astype(np.float32)\n",
    "prob_map_vis_sf = gaussian_filter(prob_map_sf, sigma=float(HEATMAP_SMOOTH_SIGMA)) if HEATMAP_SMOOTH_SIGMA > 0 else prob_map_sf\n",
    "sf_score_max = float(prob_map_sf.max())\n",
    "sf_score_mean = float(prob_map_sf.mean())\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 4.5))\n",
    "axes[0].imshow(structured_img_arr, cmap=\"gray\")\n",
    "axes[0].set_title(f\"Original\\n{structured_example_path.name}\")\n",
    "axes[0].axis(\"off\")\n",
    "\n",
    "axes[1].imshow(structured_img_arr, cmap=\"gray\")\n",
    "sf_im = axes[1].imshow(\n",
    "    prob_map_vis_sf,\n",
    "    cmap=\"jet\",\n",
    "    alpha=DENSE_OVERLAY_ALPHA,\n",
    "    vmin=0.0,\n",
    "    vmax=1.0,\n",
    "    interpolation=\"bilinear\",\n",
    ")\n",
    "axes[1].set_title(\n",
    "    \"Progressive overlay\\n\"\n",
    "    f\"max={sf_score_max:.3f} mean={sf_score_mean:.3f}\"\n",
    ")\n",
    "axes[1].axis(\"off\")\n",
    "\n",
    "axes[2].imshow(prob_map_vis_sf, cmap=\"jet\", vmin=0.0, vmax=1.0, interpolation=\"bilinear\")\n",
    "axes[2].set_title(\"Progressive heatmap\")\n",
    "axes[2].axis(\"off\")\n",
    "\n",
    "fig.suptitle(\n",
    "    \"Progressive block radial kernel inference | \"\n",
    "    f\"Test AUC={sf_results['test_05']['auc']:.3f} \"\n",
    "    f\"Test ACC@0.5={sf_results['test_05']['acc']:.3f} \"\n",
    "    f\"Test ACC@thr_val={sf_results['test_tuned']['acc']:.3f}\",\n",
    "    y=1.03,\n",
    ")\n",
    "cbar = fig.colorbar(sf_im, ax=axes.ravel().tolist(), shrink=0.8)\n",
    "cbar.set_label(\"Predicted probability\")\n",
    "fig.subplots_adjust(top=0.82, wspace=0.05)\n",
    "plt.show()\n",
    "\n",
    "if SAVE_ARTIFACTS:\n",
    "    np.save(SPIKE_FREE_OUT_DIR / \"f_spike_free_full.npy\", f_best_full_sf.astype(np.float32))\n",
    "    np.save(SPIKE_FREE_OUT_DIR / \"kernel_spike_free_radial.npy\", kernel_best_sf.astype(np.float32))\n",
    "    np.save(SPIKE_FREE_OUT_DIR / f'{structured_example_path.stem}_sf_prob_map.npy', prob_map_sf)\n",
    "    fig.savefig(SPIKE_FREE_OUT_DIR / f'{structured_example_path.stem}_sf_heatmap.png', dpi=260, bbox_inches='tight')\n",
    "    \n",
    "    sf_summary = {\n",
    "        \"seed_profile\": [float(x) for x in f_seed_full],\n",
    "        \"learned_profile\": [float(x) for x in f_best_full_sf],\n",
    "        \"metrics\": sf_results,\n",
    "        \"history\": sf_history,\n",
    "    }\n",
    "    (SPIKE_FREE_OUT_DIR / \"spike_free_summary.json\").write_text(json.dumps(sf_summary, indent=2))\n",
    "    print(f\"Saved spike-free artifacts to {SPIKE_FREE_OUT_DIR}\")\n"
   ]
  },
