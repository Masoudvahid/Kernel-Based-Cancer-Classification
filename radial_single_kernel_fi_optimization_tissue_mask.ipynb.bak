      "  from .autonotebook import tqdm as notebook_tqdm\n"
     ]
    }
   ],
   "source": [
    "from pathlib import Path\n",
    "import json\n",
    "import os\n",
    "import shutil\n",
    "\n",
    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import torch\n",
    "import torch.nn.functional as F\n",
    "from PIL import Image\n",
    "from scipy.ndimage import gaussian_filter, rotate\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.metrics import accuracy_score, roc_auc_score\n",
    "from torch.utils.data import DataLoader, TensorDataset\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "from kernel_model.config import (\n",
    "    CompositeKernelConfig,\n",
    "    KernelBankConfig,\n",
    "    PatchExtractionConfig,\n",
    "    PipelineConfig,\n",
    "    SelectionConfig,\n",
    "    SubsetSearchConfig,\n",
    "    TrainingConfig,\n",
    ")\n",
    "from kernel_model.data import load_patches_from_folders, sample_patches, to_tensor_batch\n",
    "from kernel_model.pipeline import run_pipeline\n",
    "\n",
    "# --- BRISC2025 segmentation-mask dataset settings ---\n",
    "MASK_DATASET_DIR = Path(\"data_brain/brisc2025/segmentation_task\")\n",
    "PATCH_OUTPUT_ROOT = Path(\"data_brain/patches_brisc2025_inside_outside\")\n",
    "STRUCTURED_OUT_DIR = Path(\"results/exp_brisc2025_mmr_nperFamily500_nComposition1250\")\n",
    "\n",
    "RUN_DATA_PREP = False\n",
    "RUN_STRUCTURED_PIPELINE = False\n",
    "CLEAR_PATCH_OUTPUT_BEFORE_PREP = False\n",
    "PRESERVE_OFFICIAL_TEST_SPLIT = True\n",
    "\n",
    "MASK_WHITE_THRESHOLD = 220\n",
    "PATCH_SIZE = 128\n",
    "N_INSIDE_PER_IMAGE = 16\n",
    "N_OUTSIDE_PER_IMAGE = 16\n",
    "MAX_TRIES = 300\n",
    "MIN_POS_COVERAGE = 0.20\n",
    "MAX_NEG_COVERAGE = 0.02\n",
    "NEAR_NEG_FRACTION = 0.40\n",
    "MIN_NONZERO_FRAC = 0.05\n",
    "PATCH_WHITE_PIXEL_THRESHOLD = 240\n",
    "MAX_WHITE_PIXEL_FRACTION = None\n",
    "TRAIN_FRAC = 0.85\n",
    "VAL_FRAC = 0.15\n",
    "TEST_FRAC = 0.0\n",
    "SPLIT_SEED = 42\n",
    "\n",
    "# Hard caps to prevent long, wasteful patch generation.\n",
    "MAX_SOURCE_IMAGES_PER_SPLIT = 600\n",
    "MAX_PATCHES_TRAIN_PER_CLASS = 3000\n",
    "MAX_PATCHES_VAL_PER_CLASS = 1000\n",
    "MAX_PATCHES_TEST_PER_CLASS = 1000\n",
    "\n",
    "# --- Structured + radial settings ---\n",
    "KERNEL_FILENAME = \"composite_kernel.npy\"\n",
    "DATA_ROOT = PATCH_OUTPUT_ROOT\n",
    "EXP_DIR = STRUCTURED_OUT_DIR\n",
    "\n",
    "TRAIN_SPLIT = \"train\"\n",
    "VAL_SPLIT = \"val\"\n",
    "TEST_SPLIT = \"test\"\n",
    "RESIZE_PATCH = 128\n",
    "MAX_PER_CLASS = MAX_PATCHES_TRAIN_PER_CLASS\n",
    "\n",
    "SEED_ROTATION_STEP_DEG = 10\n",
    "LEARNED_RADIUS_MAX = 25\n",
    "FREEZE_OUTER_RADII = True\n",
    "\n",
    "RESPONSE_MODE = \"mean_abs\"  # \"abs_max\" or \"mean_abs\"\n",
    "STANDARDIZE_PATCHES = True\n",
    "\n",
    "EPOCHS = 35\n",
    "BATCH_SIZE = 128\n",
    "LR_F = 3e-2\n",
    "LR_HEAD = 1e-2\n",
    "LAMBDA_SMOOTH = 1e-3\n",
    "LAMBDA_ANCHOR = 1e-1\n",
    "LAMBDA_SCALE = 5e-2\n",
    "THRESHOLD_GRID_SIZE = 181\n",
    "\n",
    "EXAMPLE_IMAGE_PATH = MASK_DATASET_DIR / \"train\" / \"images\"\n",
    "DENSE_OVERLAY_ALPHA = 0.40\n",
    "HEATMAP_SMOOTH_SIGMA = 1.2\n",
    "SAVE_ARTIFACTS = True\n",
    "\n",
    "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "torch.set_num_threads(min(8, max(1, os.cpu_count() or 1)))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "bb9d5930",
