   "source": [
    "def resolve_data_root(exp_dir: Path, data_root_override):\n",
    "    if data_root_override is not None:\n",
    "        return Path(data_root_override)\n",
    "    cfg_path = exp_dir / \"config.json\"\n",
    "    if cfg_path.exists():\n",
    "        cfg = json.loads(cfg_path.read_text())\n",
    "        return Path(cfg.get(\"data_root\", \"data/patches\"))\n",
    "    return Path(\"data/patches\")\n",
    "\n",
    "\n",
    "def list_image_mask_pairs(segmentation_root: Path):\n",
    "    segmentation_root = Path(segmentation_root)\n",
    "    pairs = []\n",
    "    for source_split in (\"train\", \"test\"):\n",
    "        images_dir = segmentation_root / source_split / \"images\"\n",
    "        masks_dir = segmentation_root / source_split / \"masks\"\n",
    "        if not images_dir.exists() or not masks_dir.exists():\n",
    "            continue\n",
    "\n",
    "        image_paths = sorted([p for p in images_dir.glob(\"*.jpg\") if p.is_file()])\n",
    "        for image_path in image_paths:\n",
    "            mask_path = masks_dir / f\"{image_path.stem}.png\"\n",
    "            if mask_path.exists():\n",
    "                pairs.append((image_path, mask_path, source_split))\n",
    "    return pairs\n",
    "\n",
    "\n",
    "def assign_split_labels(image_paths, train_frac=0.7, val_frac=0.15, seed=42):\n",
    "    image_paths = list(image_paths)\n",
    "    n = len(image_paths)\n",
    "    if n == 0:\n",
    "        return {}\n",
    "\n",
    "    rng = np.random.default_rng(seed)\n",
    "    order = rng.permutation(n)\n",
    "\n",
    "    n_train = int(round(train_frac * n))\n",
    "    n_val = int(round(val_frac * n))\n",
    "    n_test = n - n_train - n_val\n",
    "    if n_test < 0:\n",
    "        n_test = 0\n",
    "        n_val = max(0, n - n_train)\n",
    "\n",
    "    split_map = {}\n",
    "    for idx_pos, perm_idx in enumerate(order):\n",
    "        stem = image_paths[perm_idx].stem\n",
    "        if idx_pos < n_train:\n",
    "            split = \"train\"\n",
    "        elif idx_pos < n_train + n_val:\n",
    "            split = \"val\"\n",
    "        else:\n",
    "            split = \"test\"\n",
    "        split_map[stem] = split\n",
    "    return split_map\n",
    "\n",
    "\n",
    "def prepare_white_mask_patch_splits(\n",
    "    dataset_dir: Path,\n",
    "    output_root: Path,\n",
    "    patch_size: int = 128,\n",
    "    n_inside_per_image: int = 8,\n",
    "    n_outside_per_image: int = 8,\n",
    "    max_tries: int = 300,\n",
    "    mask_white_threshold: int = 220,\n",
    "    min_pos_coverage: float = 0.20,\n",
    "    max_neg_coverage: float = 0.02,\n",
    "    near_neg_fraction: float = 0.40,\n",
    "    min_nonzero_frac: float = 0.05,\n",
    "    white_pixel_threshold: int = 240,\n",
    "    max_white_pixel_fraction = None,\n",
    "    train_frac: float = 0.85,\n",
    "    val_frac: float = 0.15,\n",
    "    split_seed: int = 42,\n",
    "    clear_output: bool = False,\n",
    "    preserve_official_test_split: bool = True,\n",
    "    max_images_per_source_split: int = 150,\n",
    "    max_train_per_class: int = 3000,\n",
    "    max_val_per_class: int = 1000,\n",
    "    max_test_per_class: int = 1000,\n",
    "):\n",
    "    dataset_dir = Path(dataset_dir)\n",
    "    output_root = Path(output_root)\n",
    "\n",
    "    if clear_output and output_root.exists():\n",
    "        shutil.rmtree(output_root)\n",
    "\n",
    "    pairs = list_image_mask_pairs(dataset_dir)\n",
    "    if not pairs:\n",
    "        raise FileNotFoundError(\n",
    "            f\"No BRISC image/mask pairs found under {dataset_dir}. Expected '<split>/images/*.jpg' and '<split>/masks/*.png'.\"\n",
    "        )\n",
    "\n",
    "    n_source_total = {\"train\": 0, \"test\": 0}\n",
    "    for _, _, source_split in pairs:\n",
    "        n_source_total[source_split] = n_source_total.get(source_split, 0) + 1\n",
    "\n",
    "    rng = np.random.default_rng(split_seed)\n",
    "\n",
    "    if max_images_per_source_split is not None:\n",
    "        limit = int(max_images_per_source_split)\n",
    "        if limit <= 0:\n",
    "            raise ValueError(\"max_images_per_source_split must be >= 1 or None\")\n",
    "\n",
    "        by_source = {\"train\": [], \"test\": []}\n",
    "        for row in pairs:\n",
    "            by_source[row[2]].append(row)\n",
    "\n",
    "        selected = []\n",
    "        n_source_used = {\"train\": 0, \"test\": 0}\n",
    "        for src in (\"train\", \"test\"):\n",
    "            src_pairs = by_source.get(src, [])\n",
    "            if len(src_pairs) > limit:\n",
    "                idx = rng.permutation(len(src_pairs))[:limit]\n",
    "                src_pairs = [src_pairs[i] for i in idx]\n",
    "            n_source_used[src] = len(src_pairs)\n",
    "            selected.extend(src_pairs)\n",
    "        pairs = selected\n",
    "    else:\n",
    "        n_source_used = dict(n_source_total)\n",
    "\n",
    "    if len(pairs) > 1:\n",
    "        order = rng.permutation(len(pairs))\n",
    "        pairs = [pairs[i] for i in order]\n",
    "\n",
    "    if preserve_official_test_split:\n",
    "        train_image_paths = [img_path for img_path, _, src in pairs if src == \"train\"]\n",
    "        split_map_train = assign_split_labels(\n",
    "            train_image_paths,\n",
    "            train_frac=train_frac,\n",
    "            val_frac=val_frac,\n",
    "            seed=split_seed,\n",
    "        )\n",
    "        split_map_all = {}\n",
    "    else:\n",
    "        split_map_train = {}\n",
    "        split_map_all = assign_split_labels(\n",
    "            [img_path for img_path, _, _ in pairs],\n",
    "            train_frac=train_frac,\n",
    "            val_frac=val_frac,\n",
    "            seed=split_seed,\n",
    "        )\n",
    "\n",
    "    for split in (\"train\", \"val\", \"test\"):\n",
    "        (output_root / split / \"inside\").mkdir(parents=True, exist_ok=True)\n",
    "        (output_root / split / \"outside\").mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    counters = {\n",
    "        \"train\": {\"inside\": 0, \"outside\": 0},\n",
    "        \"val\": {\"inside\": 0, \"outside\": 0},\n",
    "        \"test\": {\"inside\": 0, \"outside\": 0},\n",
    "    }\n",
    "    filtered_white = {\n",
    "        \"train\": {\"inside\": 0, \"outside\": 0},\n",
    "        \"val\": {\"inside\": 0, \"outside\": 0},\n",
    "        \"test\": {\"inside\": 0, \"outside\": 0},\n",
    "    }\n",
    "    filtered_cap = {\n",
    "        \"train\": {\"inside\": 0, \"outside\": 0},\n",
    "        \"val\": {\"inside\": 0, \"outside\": 0},\n",
    "        \"test\": {\"inside\": 0, \"outside\": 0},\n",
    "    }\n",
    "\n",
    "    cap_map = {\n",
    "        \"train\": {\"inside\": max_train_per_class, \"outside\": max_train_per_class},\n",
    "        \"val\": {\"inside\": max_val_per_class, \"outside\": max_val_per_class},\n",
    "        \"test\": {\"inside\": max_test_per_class, \"outside\": max_test_per_class},\n",
    "    }\n",
    "\n",
    "    def keep_nonwhite_patch(patch: np.ndarray) -> bool:\n",
    "        if max_white_pixel_fraction is None:\n",
    "            return True\n",
    "        frac_white = float((patch >= int(white_pixel_threshold)).mean())\n",
    "        return frac_white <= float(max_white_pixel_fraction)\n",
    "\n",
    "    def is_class_full(split: str, cls: str) -> bool:\n",
    "        cap = cap_map[split][cls]\n",
    "        if cap is None:\n",
    "            return False\n",
    "        return counters[split][cls] >= int(cap)\n",
    "\n",
    "    def is_split_full(split: str) -> bool:\n",
    "        return is_class_full(split, \"inside\") and is_class_full(split, \"outside\")\n",
    "\n",
    "    def all_splits_full() -> bool:\n",
    "        return all(is_split_full(split) for split in (\"train\", \"val\", \"test\"))\n",
    "\n",
    "    def take_with_cap(split: str, cls: str, patches):\n",
    "        cap = cap_map[split][cls]\n",
    "        if cap is None:\n",
    "            return list(patches), 0\n",
    "        remaining = int(cap) - int(counters[split][cls])\n",
    "        if remaining <= 0:\n",
    "            return [], len(patches)\n",
    "        keep_n = min(len(patches), remaining)\n",
    "        dropped = len(patches) - keep_n\n",
    "        return list(patches[:keep_n]), dropped\n",
    "\n",
    "    for image_path, mask_path, source_split in tqdm(pairs, desc=\"Preparing masked patches\"):\n",
    "        if all_splits_full():\n",
    "            break\n",
    "\n",
    "        if preserve_official_test_split:\n",
    "            if source_split == \"test\":\n",
    "                split = \"test\"\n",
    "            else:\n",
    "                split = split_map_train.get(image_path.stem, \"train\")\n",
    "        else:\n",
    "            split = split_map_all.get(image_path.stem, \"train\")\n",
    "\n",
    "        if is_split_full(split):\n",
    "            continue\n",
    "\n",
    "        inside_target = 0 if is_class_full(split, \"inside\") else int(n_inside_per_image)\n",
    "        outside_target = 0 if is_class_full(split, \"outside\") else int(n_outside_per_image)\n",
    "        if inside_target <= 0 and outside_target <= 0:\n",
    "            continue\n",
    "\n",
    "        img = cv2.imread(str(image_path), cv2.IMREAD_GRAYSCALE)\n",
    "        mask = cv2.imread(str(mask_path), cv2.IMREAD_GRAYSCALE)\n",
    "        if img is None or mask is None:\n",
    "            continue\n",
    "        if img.shape != mask.shape:\n",
    "            mask = cv2.resize(mask, (img.shape[1], img.shape[0]), interpolation=cv2.INTER_NEAREST)\n",
    "\n",
    "        mask_bool = mask >= int(mask_white_threshold)\n",
    "\n",
    "        inside_patches, outside_patches = sample_patches(\n",
    "            img,\n",
    "            mask_bool,\n",
    "            patch_size=patch_size,\n",
    "            n_inside=inside_target,\n",
    "            n_outside=outside_target,\n",
    "            max_tries=max_tries,\n",
    "            min_pos_coverage=min_pos_coverage,\n",
    "            max_neg_coverage=max_neg_coverage,\n",
    "            near_neg_fraction=near_neg_fraction,\n",
    "            min_nonzero_frac=min_nonzero_frac,\n",
    "            use_bbox_for_positives=False,\n",
    "        )\n",
    "\n",
    "        split_root = output_root / split\n",
    "\n",
    "        inside_patches_kept = [p for p in inside_patches if keep_nonwhite_patch(p)]\n",
    "        outside_patches_kept = [p for p in outside_patches if keep_nonwhite_patch(p)]\n",
    "\n",
    "        filtered_white[split][\"inside\"] += max(0, len(inside_patches) - len(inside_patches_kept))\n",
    "        filtered_white[split][\"outside\"] += max(0, len(outside_patches) - len(outside_patches_kept))\n",
    "\n",
    "        inside_to_write, inside_dropped_cap = take_with_cap(split, \"inside\", inside_patches_kept)\n",
    "        outside_to_write, outside_dropped_cap = take_with_cap(split, \"outside\", outside_patches_kept)\n",
    "        filtered_cap[split][\"inside\"] += int(inside_dropped_cap)\n",
    "        filtered_cap[split][\"outside\"] += int(outside_dropped_cap)\n",
    "\n",
    "        for patch in inside_to_write:\n",
    "            idx = counters[split][\"inside\"]\n",
    "            out_path = split_root / \"inside\" / f\"inside_{image_path.stem}_{idx:05d}.tif\"\n",
    "            Image.fromarray(patch).save(out_path)\n",
    "            counters[split][\"inside\"] += 1\n",
    "\n",
    "        for patch in outside_to_write:\n",
    "            idx = counters[split][\"outside\"]\n",
    "            out_path = split_root / \"outside\" / f\"outside_{image_path.stem}_{idx:05d}.tif\"\n",
    "            Image.fromarray(patch).save(out_path)\n",
    "            counters[split][\"outside\"] += 1\n",
    "\n",
    "    return {\n",
    "        \"n_pairs\": len(pairs),\n",
    "        \"n_pairs_by_source_total\": n_source_total,\n",
    "        \"n_pairs_by_source_used\": n_source_used,\n",
    "        \"max_images_per_source_split\": max_images_per_source_split,\n",
    "        \"split_policy\": \"official_test_split\" if preserve_official_test_split else \"random_all\",\n",
    "        \"caps_per_class\": {\n",
    "            \"train\": max_train_per_class,\n",
    "            \"val\": max_val_per_class,\n",
    "            \"test\": max_test_per_class,\n",
    "        },\n",
    "        \"counts\": counters,\n",
    "        \"filtered_white\": filtered_white,\n",
    "        \"filtered_cap\": filtered_cap,\n",
    "        \"white_filter\": {\n",
    "            \"enabled\": max_white_pixel_fraction is not None,\n",
    "            \"white_pixel_threshold\": int(white_pixel_threshold),\n",
    "            \"max_white_pixel_fraction\": None if max_white_pixel_fraction is None else float(max_white_pixel_fraction),\n",
    "        },\n",
    "        \"output_root\": str(output_root),\n",
    "    }\n",
    "\n",
    "\n",
    "def build_structured_cfg(data_root: Path, out_dir: Path):\n",
    "    return PipelineConfig(\n",
    "        data=PatchExtractionConfig(\n",
    "            run_extraction=False,\n",
    "        ),\n",
    "        bank=KernelBankConfig(\n",
    "            n_per_family=500,\n",
    "            kernel_size=127,\n",
    "        ),\n",
    "        selection=SelectionConfig(\n",
    "            method=\"mmr\",\n",
    "            topM=1250,\n",
    "            K=90,\n",
    "            plot_top_kernels=0,\n",
    "        ),\n",
    "        composite=CompositeKernelConfig(\n",
    "            enabled=True,\n",
    "            source=\"selected\",\n",
    "            n_kernels=250,\n",
    "            weight_method=\"uniform\",\n",
    "            normalize=\"l1\",\n",
    "        ),\n",
    "        training=TrainingConfig(\n",
    "            model_type=\"logistic\",\n",
    "            standardize_features=True,\n",
    "            rotation_aug=False,\n",
    "        ),\n",
    "        subset=SubsetSearchConfig(\n",
    "            pair_corr_threshold=0.2,\n",
    "        ),\n",
    "        data_root=Path(data_root),\n",
    "        out_dir=Path(out_dir),\n",
    "        max_per_class=MAX_PER_CLASS,\n",
    "        resize_patch_size=128,\n",
    "        load_splits=(\"train\", \"val\", \"test\"),\n",
    "    )\n",
    "\n",
    "\n",
    "def load_split(root_dir: Path, split_name: str, resize_patch: int, max_per_class=None):\n",
    "    Xin, Xout = load_patches_from_folders(\n",
    "        root_dir,\n",
    "        max_per_class=max_per_class,\n",
    "        resize=(resize_patch, resize_patch),\n",
    "        splits=(split_name,),\n",
    "    )\n",
    "    return Xin.astype(np.float32), Xout.astype(np.float32)\n",
    "\n",
    "\n",
    "def integer_radius_bins(kernel_shape):\n",
    "    h, w = kernel_shape\n",
    "    cy, cx = (h - 1) / 2.0, (w - 1) / 2.0\n",
    "    yy, xx = np.indices((h, w))\n",
    "    r = np.sqrt((yy - cy) ** 2 + (xx - cx) ** 2)\n",
    "    return np.floor(r).astype(np.int64)\n",
    "\n",
    "\n",
    "def radial_profile_from_kernel(kernel2d: np.ndarray):\n",
    "    radius_bins = integer_radius_bins(kernel2d.shape)\n",
    "    max_r = int(radius_bins.max())\n",
    "    radial_sum = np.bincount(radius_bins.ravel(), weights=kernel2d.ravel(), minlength=max_r + 1)\n",
    "    radial_count = np.bincount(radius_bins.ravel(), minlength=max_r + 1)\n",
    "    profile = radial_sum / np.maximum(radial_count, 1)\n",
    "    return profile.astype(np.float32), radius_bins\n",
    "\n",
    "\n",
    "def build_radial_basis(radius_bins: np.ndarray):\n",
    "    max_r = int(radius_bins.max())\n",
    "    basis = np.stack([(radius_bins == i).astype(np.float32) for i in range(max_r + 1)], axis=0)\n",
    "    return basis.astype(np.float32)\n",
    "\n",
    "\n",
    "def patch_standardize(x_t: torch.Tensor):\n",
    "    mean = x_t.mean(dim=(2, 3), keepdim=True)\n",
    "    std = x_t.std(dim=(2, 3), keepdim=True)\n",
    "    std = torch.where(std < 1e-6, torch.ones_like(std), std)\n",
    "    return (x_t - mean) / std\n",
    "\n",
    "\n",
    "def make_xy_tensors(Xin_np: np.ndarray, Xout_np: np.ndarray, standardize: bool):\n",
    "    X = np.concatenate([Xin_np, Xout_np], axis=0).astype(np.float32)\n",
    "    y = np.concatenate([\n",
    "        np.ones(len(Xin_np), dtype=np.float32),\n",
    "        np.zeros(len(Xout_np), dtype=np.float32),\n",
    "    ])\n",
    "    X_t = to_tensor_batch(X, torch.device(\"cpu\"))\n",
    "    if standardize:\n",
    "        X_t = patch_standardize(X_t)\n",
    "    y_t = torch.from_numpy(y)\n",
    "    return X_t.contiguous(), y_t.contiguous(), y.astype(np.int64)\n",
    "\n",
    "\n",
    "def response_from_kernel(x_t: torch.Tensor, kernel2d_t: torch.Tensor, mode: str):\n",
    "    out = F.conv2d(x_t, kernel2d_t[None, None], padding=kernel2d_t.shape[-1] // 2)\n",
    "    if mode == \"abs_max\":\n",
    "        return out.abs().amax(dim=(2, 3))[:, 0]\n",
    "    if mode == \"mean_abs\":\n",
    "        return out.abs().mean(dim=(2, 3))[:, 0]\n",
    "    raise ValueError(f\"Unknown response mode '{mode}'\")\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def extract_responses(x_t: torch.Tensor, kernel2d_t: torch.Tensor, batch_size: int):\n",
    "    kernel2d_t = kernel2d_t.to(DEVICE)\n",
    "    feats = []\n",
    "    for i in range(0, x_t.shape[0], batch_size):\n",
    "        xb = x_t[i : i + batch_size].to(DEVICE, non_blocking=True)\n",
    "        feat = response_from_kernel(xb, kernel2d_t, RESPONSE_MODE)\n",
    "        feats.append(feat.detach().cpu().numpy())\n",
    "    return np.concatenate(feats, axis=0) if feats else np.zeros((0,), dtype=np.float32)\n",
    "\n",
    "\n",
    "def metrics_from_probs(y_true: np.ndarray, probs: np.ndarray, threshold: float = 0.5):\n",
    "    y_hat = (probs > float(threshold)).astype(np.int64)\n",
    "    acc = accuracy_score(y_true, y_hat)\n",
    "    auc = roc_auc_score(y_true, probs) if len(np.unique(y_true)) > 1 else float(\"nan\")\n",
    "    return {\"acc\": float(acc), \"auc\": float(auc)}\n",
    "\n",
    "\n",
    "def best_threshold_by_accuracy(y_true: np.ndarray, probs: np.ndarray, grid_size: int = 181):\n",
    "    grid = np.linspace(0.05, 0.95, int(grid_size), dtype=np.float32)\n",
    "    preds = probs[None, :] > grid[:, None]\n",
    "    accs = (preds == y_true[None, :]).mean(axis=1)\n",
    "    best_idx = int(np.argmax(accs))\n",
    "    return float(grid[best_idx]), float(accs[best_idx])\n",
    "\n",
    "\n",
    "def sigmoid_np(x):\n",
    "    return 1.0 / (1.0 + np.exp(-x))\n",
    "\n",
    "\n",
    "def ensure_example_image(path: Path):\n",
    "    path = Path(path)\n",
    "    if path.is_file() and path.exists():\n",
    "        return path\n",
    "\n",
    "    search_dirs = []\n",
    "    if path.is_dir() and path.exists():\n",
    "        search_dirs.append(path)\n",
    "\n",
    "    search_dirs.extend(\n",
    "        [\n",
    "            MASK_DATASET_DIR / \"train\" / \"images\",\n",
    "            MASK_DATASET_DIR / \"test\" / \"images\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    for image_dir in search_dirs:\n",
    "        if not image_dir.exists():\n",
    "            continue\n",
    "        candidates = sorted(image_dir.glob(\"*.jpg\"))\n",
    "        if candidates:\n",
    "            return candidates[0]\n",
    "\n",
    "    raise FileNotFoundError(\n",
    "        f\"Could not find example image under {MASK_DATASET_DIR}/<split>/images\"\n",
    "    )\n"
   ]
  },
